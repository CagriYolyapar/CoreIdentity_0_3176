@model List<AppRole>


    <h1>Yeni role eklemek icin <a asp-action="CreateRole">tıklayınız</a></h1>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (AppRole item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Status</td>
            </tr>
        }
        </tbody>
    </table>